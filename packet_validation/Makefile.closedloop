CONTIKI_PROJECT = acr_40_closed
all: $(CONTIKI_PROJECT)
CONTIKI = ../..
MAKE_NET = MAKE_NET_NULLNET
MAKE_MAC = MAKE_MAC_CSMA
CL_ROUNDS ?= 16
CL_SEED ?= 8701
CL_SCENARIO ?= 1
CL_METHOD ?= 0
CFLAGS += -DCL_ROUNDS=$(CL_ROUNDS) -DCL_SEED=$(CL_SEED) -DCL_SCENARIO=$(CL_SCENARIO) -DCL_METHOD=$(CL_METHOD)
include $(CONTIKI)/Makefile.include
